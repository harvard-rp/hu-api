{
  "name": "hu-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler deploy tests/fixtures/supabase-worker.ts --dry-run --outdir dist/supabase-check",
    "test": "vitest run --exclude tests/auth-local.test.mjs",
    "test:watch": "vitest watch --exclude tests/auth-local.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "supabase:reset": "node scripts/supabase-local.mjs reset",
    "supabase:types": "node scripts/supabase-local.mjs types",
    "test:integration": "node scripts/supabase-local.mjs test",
    "test:concurrency": "node tests/club-concurrency.mjs",
    "test:auth:local": "vitest run tests/auth-local.test.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@supabase/supabase-js": "2.119.2",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/workers-types": "5.20261125.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "openapi-types": "12.1.3",
    "prettier": "3.10.1",
    "supabase": "3.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
