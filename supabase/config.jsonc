{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "hu-api",
  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": ["public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000,
    "auto_expose_new_tables": false,
  },
  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "health_timeout": "2m",
    "major_version": 17,
    "migrations": {
      "enabled": true,
      "schema_paths": [],
    },
    "seed": {
      "enabled": true,
      "sql_paths": ["./seed.sql"],
    },
  },
  "studio": {
    "enabled": true,
    "port": 54323,
    "api_url": "http://127.0.0.1",
  },
  "auth": {
    "enabled": true,
    "site_url": "http://127.0.0.1:3000",
    "enable_signup": false,
    "enable_anonymous_sign_ins": false,
    "enable_manual_linking": false,
    "hook": {
      "before_user_created": {
        "enabled": true,
        "uri": "pg-functions://postgres/signup_guard/before_user_created",
      },
    },
    "external": {},
  },
  "local_smtp": {
    "enabled": false,
  },
  "storage": {
    "enabled": false,
  },
  "realtime": {
    "enabled": false,
  },
  "edge_runtime": {
    "enabled": false,
  },
  "analytics": {
    "enabled": false,
  },
}
